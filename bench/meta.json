{
  "flagship": "openai/gpt-5.6-sol",
  "mid": "openai/gpt-5.6-terra",
  "fast": "deepseek/deepseek-flash",
  "local": "ollama/qwen2.5:7b",
  "judge": "anthropic/claude-sonnet-5",
  "judge2": "deepseek/deepseek-v4-pro",
  "max_tokens": 4096,
  "date": "2026-09-18",
  "prompts": 120,
  "rules": [
    {
      "default": "fast"
    }
  ],
  "overrides": [
    {
      "when": "needs_reasoning > 0.8 or difficulty >= 1.3",
      "at_least": "mid"
    },
    {
      "when": "stakes > 1.5 or safety_sensitive > 0.7",
      "at_least": "mid"
    },
    {
      "when": "has_tools and tier == local",
      "at_least": "fast"
    },
    {
      "when": "retries >= 1",
      "up": 1
    }
  ],
  "note": "tiershift arm re-derived from cached fixed-arm answers under the shipped policy; identical to a rerun because one answer per (model, prompt) is shared"
}